# =============================================================
# tradingview-mcp — Local Environment Configuration
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. .env is in .gitignore — it will NEVER be committed to git
# =============================================================

# ── Proxy (Optional — Webshare Rotating Residential) ──────────
# Get credentials from: https://proxy.webshare.io/proxy/list
# Enables access to Yahoo Finance, Xueqiu, and reduces Reddit rate-limits.
# Leave blank to run WITHOUT proxy (Reddit & RSS will still work).

PROXY_HOST=p.webshare.io
PROXY_PORT=80
PROXY_USERNAME_PREFIX=your_username_prefix   # e.g. hvfvdamo
PROXY_PASSWORD=your_password_here
# Sticky-session range. Set MAX to your plan's proxy count (free plan = 10)
# so each session maps to a distinct egress IP.
PROXY_SESSION_MIN=1
PROXY_SESSION_MAX=250
# Add the host's own (direct) connection to the rotation as one extra egress
# alongside the proxies — e.g. 10 proxies + home IP = 11. Handy when your
# home/residential IP is more trusted than free-tier datacenter proxies.
PROXY_INCLUDE_DIRECT=false

# Extra self-hosted forward proxies (comma-separated full URLs), each joining
# the rotation as one more egress IP — e.g. tinyproxy/3proxy on your own
# VPS / k3s nodes. Format: http://[user:pass@]host:port. Leave blank if unused.
# Example (3 nodes, each authenticated):
#   PROXY_EXTRA_URLS=http://u:p@node1:8888,http://u:p@node2:8888,http://u:p@node3:8888
PROXY_EXTRA_URLS=

# Set to false to disable proxy entirely
PROXY_ENABLED=true
